# Copy to .env.db and fill in secrets. Never commit .env.db.
#   cp .env.example .env.db

# --- Database ---
LANDSEER_DB_HOST=localhost
LANDSEER_DB_PORT=3306
LANDSEER_DB_NAME=landseer_pipeline
LANDSEER_DB_USER=
LANDSEER_DB_PASSWORD=
LANDSEER_DB_PATH=

# --- MinIO hot tier (workers push artifacts here; GCS is via MinIO ILM) ---
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=landseer-artifacts
MINIO_SECURE=false
MINIO_REGION=us-east-1

# --- GCS cold tier (setup_minio_tiering.sh only) ---
REMOTE_BUCKET=landseer-minio-cache
REMOTE_PREFIX=landseer/YOURHOST/artifacts/
REMOTE_GCS_CREDENTIALS_FILE=helper_scripts/YOUR-gcs-bucket-key.json

# --- Evaluator containers (worker forwards this into evaluation tasks only) ---
JUDGE_API_KEY=

# --- Optional runtime ---
LANDSEER_DATA_PATH=
LANDSEER_DATA_ROOT=/data/landseer
FRONTEND_PORT=3000
