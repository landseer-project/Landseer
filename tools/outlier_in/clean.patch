+##################################### DATASET: CIFAR-10 AND CELEBA #####################################
+from __future__ import print_function
+from PIL import Image
+import os
+import os.path
+import numpy as np
+import sys
+if sys.version_info[0] == 2:
+    import cPickle as pickle
+else:
+    import pickle
+
+import torch.utils.data as data
+from .utils import noisify
+
+
+class CustomCIFAR10(data.Dataset):
+    def __init__(self, input_dir, train=True, transform=None, target_transform=None,
+                 noise_type='clean', noise_rate=0.2, random_state=0):
+        self.input_dir = input_dir
+        self.train = train
+        self.transform = transform
+        self.target_transform = target_transform
+        self.noise_type = noise_type
+        self.noise_rate = noise_rate
+        self.random_state = random_state
+        self.nb_classes = 10  # CIFAR-10
+
+        if self.train:
+            self.data = np.load(os.path.join(input_dir, "data.npy"))
+            self.labels = np.load(os.path.join(input_dir, "labels.npy"))
+
+            if noise_type != 'clean':
+                self.labels = self.labels.reshape(-1, 1)
+                self.noisy_labels, self.actual_noise_rate = noisify(
+                    dataset='cifar10',
+                    train_labels=self.labels,
+                    noise_type=noise_type,
+                    noise_rate=noise_rate,
+                    random_state=random_state,
+                    nb_classes=self.nb_classes
+                )
+                self.noisy_labels = self.noisy_labels.flatten()
+                self.labels = self.labels.flatten()
+                self.noise_or_not = self.noisy_labels == self.labels
+            else:
+                self.noisy_labels = self.labels
+                self.noise_or_not = np.ones_like(self.labels, dtype=bool)
+        else:
+            self.data = np.load(os.path.join(input_dir, "test_data.npy"))
+            self.labels = np.load(os.path.join(input_dir, "test_labels.npy"))
+
+    def __getitem__(self, index):
+        img = self.data[index]
+        target = self.noisy_labels[index] if self.train and self.noise_type != 'clean' else self.labels[index]
+
+        # Fix format: CHW → HWC and float → uint8
+        if img.dtype != np.uint8:
+            img = (img * 255).astype(np.uint8)
+
+        if img.shape[0] == 3:  # CHW check
+            img = np.transpose(img, (1, 2, 0))
+
+        img = Image.fromarray(img)
+
+        if self.transform:
+            img = self.transform(img)
+
+        return img, target, index
+
+    def __len__(self):
+        return len(self.data)
+
+
+class CustomCelebA(data.Dataset):
+    def __init__(self, input_dir, train=True, transform=None, target_transform=None,
+                 noise_type='clean', noise_rate=0.2, random_state=0):
+        self.input_dir = input_dir
+        self.train = train
+        self.transform = transform
+        self.target_transform = target_transform
+        self.noise_type = noise_type
+        self.noise_rate = noise_rate
+        self.random_state = random_state
+        self.nb_classes = 2  # CelebA is Binary
+
+        if self.train:
+            self.data = np.load(os.path.join(input_dir, "data.npy"))
+            self.labels = np.load(os.path.join(input_dir, "labels.npy"))
+
+            if noise_type != 'clean':
+                self.labels = self.labels.reshape(-1, 1)
+                # Pass 'celeba' to noisify so it handles 2 classes correctly
+                self.noisy_labels, self.actual_noise_rate = noisify(
+                    dataset='celeba', 
+                    train_labels=self.labels,
+                    noise_type=noise_type,
+                    noise_rate=noise_rate,
+                    random_state=random_state,
+                    nb_classes=self.nb_classes
+                )
+                self.noisy_labels = self.noisy_labels.flatten()
+                self.labels = self.labels.flatten()
+                self.noise_or_not = self.noisy_labels == self.labels
+            else:
+                self.noisy_labels = self.labels
+                self.noise_or_not = np.ones_like(self.labels, dtype=bool)
+        else:
+            self.data = np.load(os.path.join(input_dir, "test_data.npy"))
+            self.labels = np.load(os.path.join(input_dir, "test_labels.npy"))
+
+    def __getitem__(self, index):
+        img = self.data[index]
+        target = self.noisy_labels[index] if self.train and self.noise_type != 'clean' else self.labels[index]
+
+        # Fix format: CHW → HWC and float → uint8
+        if img.dtype != np.uint8:
+            img = (img * 255).astype(np.uint8)
+
+        # Generic CHW check (works for any size)
+        if img.shape[0] == 3:  
+            img = np.transpose(img, (1, 2, 0))
+
+        img = Image.fromarray(img)
+
+        if self.transform:
+            img = self.transform(img)
+
+        return img, target, index
+
+    def __len__(self):
+        return len(self.data)
+
+
+
+
