+#!/usr/bin/env python3
+"""
+Train defense autoencoders for CIFAR-10 dataset using MagNet approach.
+This script trains two autoencoders for detecting and reforming adversarial examples.
+"""
+import os
+import argparse
+import time
+import numpy as np
+from setup_cifar10 import CIFAR10
+from defensive_models import DenoisingAutoEncoder as DAE
+
+class DataWrapper:
+    def __init__(self, train_data, val_split=0.1):
+        n = train_data.shape[0]
+        split = int(n * (1 - val_split))
+        self.train_data = train_data[:split]
+        self.validation_data = train_data[split:]
+
+def load_and_prepare_data(input_dir):
+    train_data = np.load(os.path.join(input_dir, 'data.npy')).astype(np.float32) / 255.0
+    test_data = np.load(os.path.join(input_dir, 'test_data.npy')).astype(np.float32) / 255.0
+
+    # Ensure format is [N, 32, 32, 3]
+    if train_data.shape[1] == 3:  # If shape is [N, 3, 32, 32]
+        train_data = np.transpose(train_data, (0, 2, 3, 1))
+    if test_data.shape[1] == 3:
+        test_data = np.transpose(test_data, (0, 2, 3, 1))
+
+    wrapped = DataWrapper(train_data)
+    return wrapped, test_data
+
+def main():
+    # Parse command line arguments
+    parser = argparse.ArgumentParser(description='Train defense autoencoders for CIFAR-10 dataset')
+    parser.add_argument('--input-dir', type=str,default='/data', 
+                        help='Path to the CIFAR-10 dataset directory')
+    parser.add_argument('--output', type=str, default='/output',
+                        help='Path to save the trained models')
+    parser.add_argument('--epochs', type=int, default=400,
+                        help='Number of epochs to train (default: 400)')
+    parser.add_argument('--noise', type=float, default=0.025,
+                        help='Noise level for denoising autoencoder (default: 0.025)')
+    parser.add_argument('--reg', type=float, default=1e-9,
+                        help='Regularization strength (default: 1e-9)')
+    args = parser.parse_args()
+
+    device = 'cuda' if torch.cuda.is_available() else 'cpu'
+    print(f"Using device: {device}")
+    # Model configuration
+    shape = [32, 32, 3]
+    combination_I = [3, "average", 3, 3]  # Autoencoder with pooling
+    combination_II = [3, 3, 3]            # Autoencoder without pooling
+    activation = "sigmoid"
+    
+    # Create output directory if it doesn't exist
+    if not os.path.exists(args.output):
+        os.makedirs(args.output)
+    
+    # Load CIFAR-10 dataset
+    print("Loading training data from data.npy...")
+    data, test_data = load_and_prepare_data(args.input_dir)
+    print(f"Loaded {data.train_data.shape[0] + data.validation_data.shape[0]} training samples")
+
+
+    # Train the first autoencoder (with pooling)
+    print("\nTraining the first autoencoder (with pooling)...")
+    start_time = time.time()
+    AE_I = DAE(shape, combination_I, v_noise=args.noise, activation=activation,
+               reg_strength=args.reg, model_dir=args.output)
+    AE_I.train(data, "CIFAR10_I", num_epochs=args.epochs)
+    print(f"First autoencoder training completed in {time.time() - start_time:.2f} seconds")
+
+    # Train the second autoencoder (without pooling)
+    print("\nTraining the second autoencoder (without pooling)...")
+    start_time = time.time()
+    AE_II = DAE(shape, combination_II, v_noise=args.noise, activation=activation,
+                reg_strength=args.reg, model_dir=args.output)
+    AE_II.train(data, "CIFAR10_II", num_epochs=args.epochs)
+    print(f"Second autoencoder training completed in {time.time() - start_time:.2f} seconds")
+
+    print("\nTraining complete! Models saved to", args.output)
+    print("Files created:")
+    print(f"  - {os.path.join(args.output, 'CIFAR10_I')}")
+    print(f"  - {os.path.join(args.output, 'CIFAR10_II')}")
+
+if __name__ == "__main__":
+    main()
