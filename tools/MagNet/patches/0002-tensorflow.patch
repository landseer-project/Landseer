+## setup_cifar10.py -- cifar-10 data and model loading code
+import numpy as np
+import os
+import pickle
+
+class CIFAR10:
+    def __init__(self, data_path='./data'):
+        """
+        Load CIFAR-10 dataset from the specified path
+        
+        Args:
+            data_path: Path to the CIFAR-10 dataset directory containing the data batches
+        """
+        self.data_path = data_path
+        
+        # Load training data
+        train_data = []
+        train_labels = []
+        
+        # CIFAR-10 has 5 batch files for training
+        for i in range(1, 6):
+            file_path = os.path.join(data_path, f'data_batch_{i}')
+            if os.path.exists(file_path):
+                with open(file_path, 'rb') as f:
+                    batch = pickle.load(f, encoding='bytes')
+                    train_data.append(batch[b'data'])
+                    train_labels.extend(batch[b'labels'])
+            else:
+                raise FileNotFoundError(f"Could not find {file_path}. Make sure the CIFAR-10 dataset is in the specified directory.")
+        
+        # Combine all batches
+        train_data = np.vstack(train_data)
+        train_labels = np.array(train_labels)
+        
+        # Load test data
+        test_file = os.path.join(data_path, 'test_batch')
+        if os.path.exists(test_file):
+            with open(test_file, 'rb') as f:
+                test_batch = pickle.load(f, encoding='bytes')
+                self.test_data = test_batch[b'data']
+                self.test_labels = np.array(test_batch[b'labels'])
+        else:
+            raise FileNotFoundError(f"Could not find {test_file}. Make sure the CIFAR-10 dataset is in the specified directory.")
+        
+        # Reshape and normalize data
+        train_data = train_data.reshape(-1, 3, 32, 32).transpose(0, 2, 3, 1).astype(np.float32)
+        self.test_data = self.test_data.reshape(-1, 3, 32, 32).transpose(0, 2, 3, 1).astype(np.float32)
+        
+        # Normalize to [0, 1]
+        train_data = train_data / 255.0
+        self.test_data = self.test_data / 255.0
+        
+        # Set aside validation data
+        VALIDATION_SIZE = 5000
+        self.validation_data = train_data[:VALIDATION_SIZE]
+        self.validation_labels = self.to_categorical(train_labels[:VALIDATION_SIZE])
+        self.train_data = train_data[VALIDATION_SIZE:]
+        self.train_labels = self.to_categorical(train_labels[VALIDATION_SIZE:])
+        self.test_labels = self.to_categorical(self.test_labels)
+    
+    def to_categorical(self, y, num_classes=10):
+        """Convert a class vector to binary class matrix."""
+        return np.eye(num_classes)[y]
+    
+    @staticmethod
+    def print():
+        return "CIFAR-10"
