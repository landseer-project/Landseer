+from torch.utils.data import Dataset, DataLoader
+from torchvision import transforms
+
+class TensorDatasetWithTransform(Dataset):
+    def __init__(self, data, labels, transform=None):
+        """
+        data: np.ndarray, shape (N, H, W, C) or (N, C, H, W) or (N, H, W)
+        labels: np.ndarray of ints, shape (N,)
+        """
+        self.data = data
+        self.labels = labels
+        self.transform = transform
+
+    def __len__(self):
+        return self.data.shape[0]
+
+    def __getitem__(self, idx):
+        x = self.data[idx]
+        y = int(self.labels[idx])
+
+        # ensure CHW float32 in [0,1]
+        if x.ndim == 3:
+            if x.shape[-1] in (1, 3):        # HWC -> CHW
+                x = np.transpose(x, (2, 0, 1))
+        elif x.ndim == 2:
+            x = x[None, ...]                 # HW -> 1xHxW
+
+        # x = torch.from_numpy(x).float()
+        # if x.max() > 1.0:
+        #     x = x / 255.0
+
+        x = torch.from_numpy(x).float()
+
+        # Fix legacy saved tensors where Normalize(mean=0.5,std=0.5) was applied on 0..255 arrays before saving:
+        # That produces values in [-1, 509] (i.e., 2*raw - 1). Detect and invert it.
+        if x.max() > 400 and x.min() <= -0.5:
+            x = (x + 1.0) / 2.0  # back to 0..255
+
+        # Now ensure [0,1]
+        if x.max() > 1.5:
+            x = x / 255.0
+
+        if self.transform:
+            x = self.transform(x)
+        return x, y
+
