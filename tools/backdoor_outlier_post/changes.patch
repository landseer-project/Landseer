+# -------------------------
+# Safe BN -> MaskBN swap (no change to config_model.py needed)
+# -------------------------
+def swap_bn_to_maskbn(module):
+    """
+    Recursively replace nn.BatchNorm2d with models.MaskBatchNorm2d in-place.
+    Copies affine params and running stats if present. Works when
+    track_running_stats=False (running stats are None).
+    """
+    for name, child in list(module.named_children()):
+        if isinstance(child, nn.BatchNorm2d):
+            # Try full signature; fall back to minimal if needed
+            try:
+                mbn = models.MaskBatchNorm2d(
+                    child.num_features,
+                    eps=getattr(child, "eps", 1e-5),
+                    momentum=getattr(child, "momentum", 0.1),
+                    affine=getattr(child, "affine", True),
+                    track_running_stats=getattr(child, "track_running_stats", True),
+                )
+            except TypeError:
+                mbn = models.MaskBatchNorm2d(child.num_features)
+
+            # Copy affine params
+            if getattr(child, "affine", False):
+                with torch.no_grad():
+                    if getattr(child, "weight", None) is not None:
+                        mbn.weight.copy_(child.weight)
+                    if getattr(child, "bias", None) is not None:
+                        mbn.bias.copy_(child.bias)
+
+            # Copy running stats if they exist
+            if getattr(child, "track_running_stats", False):
+                with torch.no_grad():
+                    if getattr(child, "running_mean", None) is not None:
+                        mbn.running_mean.copy_(child.running_mean)
+                    if getattr(child, "running_var", None) is not None:
+                        mbn.running_var.copy_(child.running_var)
+                    if getattr(child, "num_batches_tracked", None) is not None:
+                        mbn.num_batches_tracked.copy_(child.num_batches_tracked)
+
+            setattr(module, name, mbn)
+        else:
+            swap_bn_to_maskbn(child)
+
