# Copy to helper_scripts/vm_worker.env and edit for each VM.

# Your local machine Tailscale IP running backend + MinIO
LANDSEER_HOST_IP=xxxxxxxxxxx

# Backend URL reachable from VM over Tailscale
LANDSEER_BACKEND_URL="http://${LANDSEER_HOST_IP}:8000"

# Same API key used by backend auth
LANDSEER_PIPELINE_KEYS="replace-with-your-key"

# MinIO settings (must match backend side)
MINIO_ENDPOINT="${LANDSEER_HOST_IP}:9000"
MINIO_ACCESS_KEY="replace-with-minio-access-key"
MINIO_SECRET_KEY="replace-with-minio-secret-key"
MINIO_BUCKET="landseer-artifacts"
MINIO_SECURE="false"

# Worker options per VM
WORKER_ID="gcp-$(hostname)"
WORKER_GPU="0"
WORKER_RUNTIME="docker"
WORKER_CACHE_DIR="/tmp/landseer_cache"
WORKER_WORKSPACE="/tmp/landseer_worker"
WORKER_POLL_INTERVAL="5.0"
WORKER_HEARTBEAT_INTERVAL="30.0"

# Optional extra CLI args for worker
# Example: WORKER_EXTRA_ARGS="--debug --log-level DEBUG"
WORKER_EXTRA_ARGS=""
